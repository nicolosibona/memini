# Copy to .env.local and fill in. Never commit .env.local.
#
# Everything works without any key: LLM_PROVIDER=mock runs the rule-based readers and saved answers for the demo files.
# The keys used at the hackathon have expired; bring your own to turn on live AI (anthropic is the simplest).

# Product for a brand-new database: electronics (spec checks, the hackathon version) | sourcing | china_business
MEMINI_PROFILE=electronics

# Which AI to use: mock (no key) | anthropic | gateway | qwen
LLM_PROVIDER=mock
# AI_PAUSE_MS=600000           # a rejected key (401/403) switches to rules for this long, then retries
LLM_TIMEOUT_MS=8000            # intent; the steps below have their own budgets
# LLM_TIMEOUT_EXTRACT_MS=45000
# LLM_TIMEOUT_ANALYZE_MS=30000
# LLM_TIMEOUT_DRAFT_MS=30000
# ASSISTANT_TIMEOUT_MS=60000
MOCK_DELAY_MS=300

# An Anthropic- or OpenAI-compatible API gateway (the hackathon used one). anthropic = /v1/messages (full features: PDFs, tools, structured outputs)
#                                                 openai    = /v1/chat/completions (no PDFs; assistant falls back to rules)
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_API_STYLE=anthropic

# Claude via the Anthropic API directly (needs a proxy/hotspot in mainland China)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Model per pipeline step. Config, not code.
# MODEL_INTENT=claude-haiku-5-5
# MODEL_EXTRACT=claude-opus-5-5
# MODEL_ANALYZE=claude-opus-5-5
# MODEL_DRAFT=claude-opus-5-5
# MODEL_ASSISTANT=claude-opus-5-5
# MODEL_SPEC=claude-opus-5-5          # reading datasheets / PDFs / photos for the spec check
# MODEL_SPEC_CHAT=claude-haiku-5-5     # reading one WeChat message for the spec check (fast)
# EFFORT_ASSISTANT=medium   # default: low on WeChat, medium on the web

# Qwen-VL via Alibaba DashScope (works in mainland China). Assistant tool loop is Claude-only; qwen uses the rule-based assistant.
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # international account
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

# Speech-to-text for WeChat voice notes (ElevenLabs). Needs ffmpeg on the server for AMR/SILK → WAV.
ELEVENLABS_API_KEY=
# MODEL_ASR=scribe_v2

# WeChat customer service (微信客服) via WeCom — see docs/wechat-setup.md
WECOM_CORP_ID=
WECOM_APP_SECRET=            # secret of the self-built app selected as the 微信客服 API app
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_OPEN_KFID=
# WECOM_DEBOUNCE_MS=6000      # group forwards within 6 s into one reply
# WECOM_SEND_BUDGET=5         # [VERIFY §17.4]
# WECOM_MENU_HEAD_MAX=900     # bytes of msgmenu.head_content before splitting [VERIFY §17.3]

# Storage and links
DB_PATH=./storage/memini.db
STORAGE_DIR=./storage/files
APP_BASE_URL=http://localhost:3000
LINK_SECRET=change-me        # signs the /s/<token> supplier links sent over WeChat

# Supplier confirmation links (/c/<token>): days before a link expires
# CONFIRM_LINK_DAYS=14

# Email to Memini — free, pick ONE (README → "Email to Memini"):
# A) No domain: a dedicated Gmail (2-Step Verification + app password) or QQ Mail (IMAP authorization code) inbox.
#    The server reads it every IMAP_POLL_SECONDS and marks emails read.
# IMAP_HOST=imap.gmail.com          # QQ Mail: imap.qq.com
# IMAP_PORT=993
# IMAP_USER=memini.inbox@gmail.com
# IMAP_PASSWORD=                    # the 16-letter app password / QQ authorization code — never your normal password
# IMAP_POLL_SECONDS=60
# EMAIL_INBOUND_ADDRESS=memini.inbox@gmail.com   # shown in Settings as memini.inbox+<token>@gmail.com
# EMAIL_PLUS_ADDRESSING=1           # 0 for QQ Mail (no +token addresses): then only allowed senders get in
# B) Your own domain on Cloudflare: Email Routing → Worker (scripts/cloudflare-email-worker.js) → /api/inbound/email/<token>
# EMAIL_INBOUND_DOMAIN=in.example.com
# Who may send without the secret token in the address (your own addresses, comma-separated):
# EMAIL_ALLOWED_SENDERS=you@yourcompany.com,you@gmail.com
