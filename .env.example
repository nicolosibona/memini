# Copy to .env.local and fill in. Never commit .env.local.
# Which AI to use: mock (no key, cached golden answers) | qwen | anthropic
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=8000

# Qwen-VL via Alibaba DashScope (works in mainland China)
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1   # international account
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus

# Claude via the Anthropic API (needs a proxy/hotspot in mainland China)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# WeChat customer service (微信客服) via WeCom — see blueprint §6
WECOM_CORP_ID=
WECOM_APP_SECRET=            # secret of the self-built app selected as the 微信客服 API app
WECOM_AGENT_ID=
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_OPEN_KFID=

# Storage
DB_PATH=./storage/copilot.db
STORAGE_DIR=./storage/files
APP_BASE_URL=http://localhost:3000
